            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "bd9c81d3-329a-5849-b8ac-cbc068be465a",
              "leftValue": "={{ (() => { const b = Object.keys($binary || {}); const n = Number($json.body.lotes); return n >= 1 && b.includes('indice') && b.includes('status_pmib') && Array.from({ length: n }, (_, i) => 'lote_' + String(i + 1).padStart(2, '0')).every(k => b.includes(k)) ? 'sim' : 'nao'; })() }}",
