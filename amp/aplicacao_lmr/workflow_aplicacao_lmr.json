        700,
        480
      ],
      "id": "86244a6d-db52-5704-8ae7-201c50e39aa0",
      "name": "Responde sem arquivos"
    },
    {
      "parameters": {
        "jsCode": "// Um item por arquivo de texto, na ordem: indice, status_pmib, lote_01…lote_NN.\nconst entrada = $input.first();\nconst b = entrada.binary || {};\nconst n = Number(entrada.json.lotes);\nconst chaves = ['indice', 'status_pmib'];\nfor (let i = 1; i <= n; i++) chaves.push('lote_' + String(i).padStart(2, '0'));\nreturn chaves.map(k => ({ json: { arquivo: k }, binary: { data: b[k] } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        200
      ],
      "id": "12b036ee-d2e4-52a4-b043-733cb3e065a8",
      "name": "Separa os arquivos"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1160,
        200
      ],
      "id": "4da60224-5b13-595d-bc41-7f4c026e2923",
      "name": "Lê o texto"
    },
    {
      "parameters": {
        "jsCode": "// Uma mensagem por lote: regras de formato, pedido, indice, catalogo e o texto do lote.\nconst CAB = 'FICHA_PMIB;AREA_PAINEL;RDS_PP;TAG;TAG_COM_RDS_PP;PAIS;LOCAL;ELEVACAO;EIXO;TRECHOS;QTD_POR_TRECHO;DOCUMENTO;PAGINA';\nconst pedido = $('Webhook do SIG-FT').first().json.body || {};\nconst textos = $input.all().map(i => String(i.json.data ?? ''));\nconst [indice, catalogo, ...lotes] = textos;\nreturn lotes.map((lote, i) => ({ json: { numero: i + 1, total: lotes.length, chatInput: [\n  'Responda SOMENTE com o CSV (cabecalho e linhas), separador \";\", sem texto antes ou depois.',\n  'Cabecalho: ' + CAB,\n  '',\n  '## PEDIDO',\n  'Escopo: ' + (pedido.escopo || '') + ' | Subsistema: ' + (pedido.subsistema || '') + ' | Trechos: ' + (pedido.trechos || ''),\n  '',\n  '## ÍNDICE DOS DOCUMENTOS',\n  indice,\n  '',\n  '## CATÁLOGO DE MATERIAIS (_STATUS_PMIB)',\n  catalogo,\n  '',\n  '## LOTE ' + (i + 1) + ' DE ' + lotes.length,\n  lote,\n].join('\\n') } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        200
      ],
      "id": "c0a6d220-94a1-5706-9aaf-964664ab68a0",
      "name": "Monta a mensagem"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1600,
        200
      ],
      "id": "e9d82953-0b75-519b-af7e-1f8641088683",
      "name": "Um lote por volta"
    },
