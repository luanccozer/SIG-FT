    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, modo: 'aplicacao_lmr', etapa: 'arquivos', erro: 'os arquivos não chegaram ao workflow: faltam o índice, o catálogo ou algum lote (recebidos: ' + Object.keys($binary || {}).length + ', lotes anunciados: ' + $json.body.lotes + ')', versao_workflow: '2026-11-11', execucao: $execution.id }) }}",
        "options": {
