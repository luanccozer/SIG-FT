// =====================================================================
// SOBRESSALENTES — MODELO v2 — MEDIDAS
// Como colar todas de uma vez: Power BI Desktop > Exibição de consulta DAX
// (DAX query view) > colar este arquivo inteiro > clicar em
// "Atualizar modelo com alterações" (Update model with changes) que aparece
// acima do DEFINE. As medidas vão para as tabelas indicadas.
//
// Unidade de contagem: FICHA = código PMIB distinto, sem as linhas DUPLICADO
// (mesma regra do SIG-FT). STATUS DUPLICADO = o mesmo item repetido NA MESMA LISTA:
// a linha repete o PMIB de outra e não é ficha nova — mas a quantidade dela conta
// no valor. A ficha duplicada DE OUTRO SISTEMA (PDM.9900.000) é ficha nova e conta.
// =====================================================================
DEFINE
    // ---------------- Fichas ----------------
    MEASURE Itens[Fichas] =
        CALCULATE ( DISTINCTCOUNT ( Itens[PMIB] ), Itens[E Ficha] = TRUE () )
    MEASURE Itens[Fichas Emitidas] =
        CALCULATE ( [Fichas], Itens[Emitida] = TRUE () )
    MEASURE Itens[Fichas em Análise IB] =
        CALCULATE ( [Fichas], Itens[Status] = "EM ANÁLISE IB" )
    MEASURE Itens[Fichas em Correção] =
        CALCULATE ( [Fichas], Itens[Status] = "EM CORREÇÃO" )
    MEASURE Itens[Fichas Aprovadas] =
        CALCULATE ( [Fichas], Itens[Status] = "APROVADO" )
    MEASURE Itens[Fichas em Preparação] =
        CALCULATE ( [Fichas], Itens[Status] IN { "INICIAR", "FICHA CRIADA", "COM O FORNECEDOR", "EM ELABORAÇÃO" } )
    MEASURE Itens[Fichas com o Fornecedor] =
        CALCULATE ( [Fichas], Itens[Status] = "COM O FORNECEDOR" )
    MEASURE Itens[Fichas sem Status Válido] =
        CALCULATE ( [Fichas], Itens[Status] IN { "N/A", "SEM STATUS" } )
    MEASURE Itens[% Emitidas] =
        DIVIDE ( [Fichas Emitidas], [Fichas] )
    MEASURE Itens[% Aprovadas] =
        DIVIDE ( [Fichas Aprovadas], [Fichas] )
    MEASURE Itens[Taxa de Aprovação das Emitidas] =
        DIVIDE ( [Fichas Aprovadas], [Fichas Emitidas] )
    MEASURE Itens[Taxa de Devolução] =
        DIVIDE ( [Fichas em Correção], [Fichas Emitidas] )

    // ---------------- Seções da ficha ----------------
    MEASURE Itens[Fichas Info Fornecedor Completa] =
        CALCULATE ( [Fichas], Itens[Info Fornecedor OK] = TRUE () )
    MEASURE Itens[Fichas Valorizadas] =
        CALCULATE ( [Fichas], Itens[Valorizacao OK] = TRUE () )
    MEASURE Itens[Fichas com LMR] =
        CALCULATE ( [Fichas], Itens[LMR OK] = TRUE () )
    MEASURE Itens[% Info Fornecedor] =
        DIVIDE ( [Fichas Info Fornecedor Completa], [Fichas] )
    MEASURE Itens[% Valorização] =
        DIVIDE ( [Fichas Valorizadas], [Fichas] )
    MEASURE Itens[% LMR] =
        DIVIDE ( [Fichas com LMR], [Fichas] )

    // ---------------- Tipo de entrega ----------------
    MEASURE Itens[Itens Físicos] =
        CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "FÍSICA E DOCUMENTAL" )
    MEASURE Itens[Itens Físicos Entregues] =
        CALCULATE ( [Itens Físicos], Itens[Entregue] = TRUE () )
    MEASURE Itens[% Físicos Entregues] =
        DIVIDE ( [Itens Físicos Entregues], [Itens Físicos] )
    MEASURE Itens[Fichas Documentais] =
        CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "DOCUMENTAL" )
    MEASURE Itens[Fichas sem Tipo de Entrega] =
        CALCULATE ( [Fichas], Itens[Tipo de Entrega] = "NÃO CLASSIFICADO" )

    // ---------------- Trilha logística: autorização de Itaipu (15 d.u.) ----------------
    // SITUAÇÃO DA AUTORIZAÇÃO e DIAS DE ATRASO vêm do SIG-FT (gravados no _STATUS_PMIB).
    // DIAS DE ATRASO = dias corridos além do prazo; congela quando Itaipu autoriza.
    // Só FÍSICA E DOCUMENTAL precisa de autorização. DOCUMENTAL/TÍTULO = "N/A"; tipo vazio =
    // "SEM TIPO DE ENTREGA" — nenhum dos dois conta nos pedidos.
    MEASURE Itens[Pedidos de Autorização] =
        CALCULATE ( [Fichas], NOT ISBLANK ( Itens[Data Email] ),
                    Itens[Situacao Autorizacao] IN { "AGUARDANDO ITAIPU", "ATRASADO ITAIPU", "AUTORIZADO", "AGUARDANDO CÁLCULO DO SIG-FT" } )
    MEASURE Itens[Fichas que Não Precisam de Autorização] =
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "N/A" )
    MEASURE Itens[Pedidos de Autorização Pendentes] =
        [Aguardando Itaipu no Prazo] + [Autorizações Atrasadas Itaipu]
    MEASURE Itens[Aguardando Itaipu no Prazo] =
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AGUARDANDO ITAIPU" )
    MEASURE Itens[Aguardando Cálculo do SIG-FT] =
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AGUARDANDO CÁLCULO DO SIG-FT" )
    MEASURE Itens[Autorizações Atrasadas Itaipu] =
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
    MEASURE Itens[Autorizadas] =
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AUTORIZADO" )
    MEASURE Itens[Autorizadas com Atraso] =
        // autorizadas cujo DIAS DE ATRASO ficou congelado acima de zero
        CALCULATE ( [Fichas], Itens[Situacao Autorizacao] = "AUTORIZADO", Itens[Dias de Atraso] > 0 )
    MEASURE Itens[Maior Atraso Itaipu (dias)] =
        CALCULATE ( MAX ( Itens[Dias de Atraso] ), Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
    MEASURE Itens[Atraso Médio Itaipu (dias)] =
        CALCULATE ( AVERAGE ( Itens[Dias de Atraso] ), Itens[Situacao Autorizacao] = "ATRASADO ITAIPU" )
    MEASURE Itens[Aptas Aguardando Entrega] =
        CALCULATE ( [Itens Físicos], Itens[Apto] = TRUE (), Itens[Entregue] = FALSE () )

    // ---------------- Trilha documental: compromisso de LMR (3 meses do e-mail) ----------------
    MEASURE Itens[LMR Fora do Compromisso] =
        CALCULATE ( [Fichas], Itens[Situacao LMR] = "LMR FORA DO COMPROMISSO" )
    MEASURE Itens[LMR em Atenção] =
        CALCULATE ( [Fichas], Itens[Situacao LMR] = "LMR EM ATENÇÃO" )
    MEASURE Itens[Maior Atraso LMR (dias)] =
        CALCULATE ( MAX ( Itens[Dias desde Email] ), Itens[Situacao LMR] = "LMR FORA DO COMPROMISSO" )

    // ---------------- Valor (lista de preços) ----------------
    MEASURE Itens[Valor Físico USD] =
        SUM ( Itens[Valor Linha USD] )
    MEASURE Itens[Valor Entregue USD] =
        // Ficha Entregue: a linha DUPLICADO herda o "entregue" da linha da ficha
        CALCULATE ( [Valor Físico USD], Itens[Ficha Entregue] = TRUE () )
    MEASURE Itens[Fichas Duplicadas de Outro Sistema] =
        CALCULATE ( [Fichas], Itens[Duplicada de Outro Sistema] = TRUE () )
    MEASURE Itens[% Valor Entregue] =
        DIVIDE ( [Valor Entregue USD], [Valor Físico USD] )
    MEASURE Itens[Fichas com Preço] =
        CALCULATE ( [Fichas], NOT ISBLANK ( Itens[Valor Unitario USD] ) )

    // ---------------- Fila de trabalho ----------------
    MEASURE Itens[Pendências CMI] =
        CALCULATE ( [Fichas], Itens[Pendencia] <> "—" )

    // ---------------- Listas ----------------
    MEASURE Listas[Listas] =
        COUNTROWS ( Listas )
    MEASURE Listas[Listas Aprovadas EN.DT] =
        CALCULATE ( [Listas], Listas[Status Real] = "APROVADO" )
    MEASURE Listas[Listas com Fichas] =
        COUNTROWS ( FILTER ( Listas, [Fichas] > 0 ) )
    MEASURE Listas[Listas Aprovadas sem Fichas] =
        COUNTROWS ( FILTER ( Listas, Listas[Status Real] = "APROVADO" && ( ISBLANK ( [Fichas] ) || [Fichas] = 0 ) ) )
    MEASURE Listas[Listas sem Responsável] =
        CALCULATE ( [Listas], Listas[Tem Responsavel] = FALSE () )
    MEASURE Listas[Listas Cadastradas] =
        // as da mapeadora (sem as que só existem como _STATUS_PMIB)
        CALCULATE ( [Listas], Listas[Origem Cadastro] = "MAPEADORA" )
    MEASURE Listas[Listas Aprovadas (texto)] =
        FORMAT ( [Listas Aprovadas EN.DT], "#,##0" ) & " de " & FORMAT ( [Listas Cadastradas], "#,##0" )
    MEASURE Listas[Listas Para Assinatura] =
        CALCULATE ( [Listas], Listas[Situacao Lista] = "Para assinatura" )
    MEASURE Listas[Listas Em Processo no Aconex] =
        CALCULATE ( [Listas], Listas[Situacao Lista] = "Em processo" )
    MEASURE Listas[Listas Não Aprovadas] =
        CALCULATE ( [Listas], Listas[Situacao Lista] = "Não aprovado" )
    MEASURE Listas[Listas Não Emitidas] =
        CALCULATE ( [Listas], Listas[Situacao Lista] = "Não emitido" )
    MEASURE Listas[Listas com Lista de Preços] =
        CALCULATE ( [Listas Cadastradas], Listas[Situacao Lista de Precos] <> "Sem lista de preços" )
    MEASURE Listas[Listas com Lista de Preços (texto)] =
        FORMAT ( [Listas com Lista de Preços], "#,##0" ) & " de " & FORMAT ( [Listas Cadastradas], "#,##0" )
    MEASURE Listas[Listas com Lista de Preços no Aconex] =
        // emitida no Aconex (a PB021 que ainda esta so na pasta e "em elaboracao", nao conta)
        CALCULATE ( [Listas Cadastradas],
            NOT Listas[Situacao Lista de Precos] IN { "Sem lista de preços", "Em elaboração (CMI)" } )
    MEASURE Listas[Listas com Lista de Preços no Aconex (texto)] =
        FORMAT ( [Listas com Lista de Preços no Aconex], "#,##0" ) & " de " & FORMAT ( [Listas Cadastradas], "#,##0" )
    MEASURE Listas[Listas com Lista de Preços Aprovada] =
        CALCULATE ( [Listas], Listas[Situacao Lista de Precos] IN { "Aprovado", "Aprovado com comentários" } )
    MEASURE Listas[Listas com Lista de Preços em Análise] =
        CALCULATE ( [Listas], Listas[Situacao Lista de Precos] IN { "Para assinatura", "Em processo", "Informativo" } )
    MEASURE Listas[Listas com Revisão Desatualizada] =
        // a revisão em uso no _STATUS_PMIB não é a última emitida no Aconex
        CALCULATE ( [Listas], Listas[Revisao Desatualizada] = TRUE () )

    // ---------------- Listas de preços (Aconex) ----------------
    MEASURE Listas[Fichas na Lista] =
        // 0 em vez de vazio: a tabela de listas mostra tambem as que ainda nao tem ficha
        COALESCE ( [Fichas], 0 )
    MEASURE PrecosAconex[Listas de Preços] =
        // todas: no Aconex e em elaboração (PB021 na pasta, fora do follow-up)
        COUNTROWS ( PrecosAconex )
    MEASURE PrecosAconex[Listas de Preços Emitidas] =
        // no Aconex (a aba de follow-up); as PB021 só na pasta são "em elaboração"
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] <> "EM ELABORAÇÃO" )
    MEASURE PrecosAconex[Listas de Preços em Elaboração] =
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] = "EM ELABORAÇÃO" )
    MEASURE PrecosAconex[Listas de Preços Aprovadas SM.DT] =
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] = "APROVADA SM.DT" )
    MEASURE PrecosAconex[Listas de Preços no Código Antigo] =
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Geracao] = "PB020-0x (legado)" )

    MEASURE PrecosAconex[Listas de Preços Aguardando SM.DT] =
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] = "EMITIDA" )
    MEASURE PrecosAconex[Listas de Preços Não Aprovadas] =
        CALCULATE ( COUNTROWS ( PrecosAconex ), PrecosAconex[Situacao Preco] = "NÃO APROVADA" )
    MEASURE Listas[Listas sem Lista de Preços] =
        // listas com ficha e sem nenhuma lista de preços registrada na aba de follow-up
        COUNTROWS ( FILTER ( Listas, [Fichas] > 0 && CALCULATE ( COUNTROWS ( PrecosAconex ) ) = 0 ) )

    // ---------------- Eventos de pagamento ----------------
    MEASURE Eventos[% do Evento Cumprido] =
        // ENTREGA: itens físicos entregues; APROVAÇÃO: fichas aprovadas — nas listas ligadas ao evento
        VAR Tipo = SELECTEDVALUE ( Eventos[Tipo Evento] )
        RETURN SWITCH ( Tipo, "ENTREGA", [% Físicos Entregues], "APROVAÇÃO", [% Aprovadas] )

    // ---------------- Rótulos ----------------
    MEASURE Itens[Enviadas a Itaipu (texto)] =
        FORMAT ( [Fichas Emitidas], "#,##0" ) & " · " & FORMAT ( [% Emitidas], "0%" )
    MEASURE Itens[Aprovadas (texto)] =
        FORMAT ( [Fichas Aprovadas], "#,##0" ) & " · " & FORMAT ( [% Aprovadas], "0%" )
    MEASURE Itens[Atualizado em] =
        "Dados de " & FORMAT ( MAX ( Itens[Data Referencia] ), "dd/mm/yyyy" )
    MEASURE Itens[Rótulo Atraso Itaipu] =
        VAR N = [Autorizações Atrasadas Itaipu]
        RETURN IF ( N > 0, FORMAT ( N, "0" ) & " fichas aguardam autorização além de 15 dias úteis", "Nenhuma autorização fora do prazo" )

EVALUATE
    ROW ( "Fichas", [Fichas], "Emitidas", [Fichas Emitidas], "Aprovadas", [Fichas Aprovadas],
          "Atrasadas Itaipu", [Autorizações Atrasadas Itaipu], "LMR fora", [LMR Fora do Compromisso] )
